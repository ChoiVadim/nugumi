<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Gizmate is ad-hoc signed for personal/dev distribution. With hardened
        runtime enabled (required by Sparkle 2), library validation rejects
        Sparkle.framework because ad-hoc signatures have no Team Identifier
        to match. Disabling library validation allows the framework to load
        while keeping the rest of the runtime hardening.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!--
        Hardened runtime blocks microphone access unless the app is entitled to
        it. Live Translation captures the mic via AVAudioEngine, so without this
        AVCaptureDevice.requestAccess fails silently (no system prompt, app never
        appears in Privacy ▸ Microphone). System audio uses ScreenCaptureKit,
        which is TCC-gated (NSScreenCaptureUsageDescription), not an entitlement.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
